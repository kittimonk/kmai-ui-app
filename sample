import re
import pandas as pd
import argparse

def clean_transformation(text: str) -> str | None:
    """
    Clean transformation logic text.
    Returns valid SQL expression or None if junk/comment.
    """

    if not isinstance(text, str) or not text.strip():
        return None

    # remove inline comments like --, #, ??, (), []
    text = re.sub(r'(--.*$)|(#.*$)|(\?\?.*)', '', text, flags=re.MULTILINE)
    text = re.sub(r'[\[\]\(\)]*$', '', text).strip()

    # normalize spaces
    text = re.sub(r'\s+', ' ', text)

    # Heuristic: if contains SQL keywords/functions, keep it
    sql_keywords = r"\b(join|case|when|then|else|end|upper|lower|substr|cast|coalesce|decode)\b"
    if re.search(sql_keywords, text, re.I):
        return text

    # Simple expression check: col1 + col2, col*1.2, etc.
    if re.match(r'^[\w\.]+\s*[\+\-\*\/]\s*[\w\d\.\']+', text):
        return text

    # If looks like column reference, allow
    if re.match(r'^[a-zA-Z_][\w\.]*$', text):
        return text

    return None


def generate_sql(df: pd.DataFrame, src_table: str, tgt_table: str) -> str:
    """
    Generate SELECT SQL using cleaned transformation logic.
    """
    df["sql_logic"] = df["Transformation Logic"].apply(clean_transformation)

    joins = df[df["sql_logic"].str.contains("join", case=False, na=False)]["sql_logic"].tolist()
    select_exprs = df[~df["sql_logic"].str.contains("join", case=False, na=False)]["sql_logic"].dropna().tolist()

    sql = f"""
    INSERT INTO {tgt_table}
    SELECT
        {",\n        ".join(select_exprs)}
    FROM {src_table} src
    {" ".join(joins)}
    ;
    """
    return sql


def main():
    parser = argparse.ArgumentParser(description="Generate SQL from Source-to-Target Mapping CSV")
    parser.add_argument("csv_file", help="Path to STM CSV file")
    parser.add_argument("--src", required=True, help="Source table name (with schema if needed)")
    parser.add_argument("--tgt", required=True, help="Target table name (with schema if needed)")
    parser.add_argument("--out", default="output.sql", help="Output SQL file")
    args = parser.parse_args()

    df = pd.read_csv(args.csv_file)
    sql = generate_sql(df, args.src, args.tgt)

    with open(args.out, "w") as f:
        f.write(sql)

    print(f"✅ SQL generated and saved to {args.out}")


if __name__ == "__main__":
    main()
