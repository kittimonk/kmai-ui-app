import re
import pandas as pd
import argparse

def clean_freeform(text: str) -> str | None:
    """Clean freeform text into SQL-like logic if possible."""
    if not isinstance(text, str) or not text.strip():
        return None

    # remove inline notes, jira, dates, etc.
    text = re.sub(r'(jira\s*#?\s*\d+)', '', text, flags=re.I)
    text = re.sub(r'date\s*\d{1,2}\s*\w+\s*\d{2,4}', '', text, flags=re.I)
    text = re.sub(r'(--.*$)|(#.*$)|(\?\?.*)', '', text, flags=re.MULTILINE)
    text = re.sub(r'[\[\(].*?[\]\)]', '', text)  # remove anything inside () or []
    text = re.sub(r'not applicable', '', text, flags=re.I)
    text = text.strip()

    # normalize spaces
    text = re.sub(r'\s+', ' ', text)

    # Detect SQL-ish content
    sql_keywords = r"\b(join|case|when|then|else|end|upper|lower|substr|cast|coalesce|decode|select|where)\b"
    if re.search(sql_keywords, text, re.I):
        return text

    # Arithmetic or concatenation expressions
    if re.match(r'^[\w\.]+\s*[\+\-\*\/]\s*[\w\d\.\']+', text):
        return text

    # Simple column reference
    if re.match(r'^[a-zA-Z_][\w\.]*$', text):
        return text

    return None


def build_cleaned_mapping(excel_file: str, out_file: str = "cleaned_mapping.xlsx"):
    # Load sheets
    stm_df = pd.read_excel(excel_file, sheet_name="field source to target mapping")
    rules_df = pd.read_excel(excel_file, sheet_name="transformation rules")
    edh_df = pd.read_excel(excel_file, sheet_name="EDH reference")

    # Merge rules into STM where rule id matches
    stm_df = stm_df.merge(rules_df, how="left", left_on="transformation rule #", right_on="rule id")

    cleaned_logic = []

    for _, row in stm_df.iterrows():
        logic = None

        # Case 1: If rule logic is available from Sheet 2
        if pd.notna(row.get("rule logic")):
            logic = clean_freeform(str(row["rule logic"]))

        # Case 2: If "EDH derived"
        elif str(row["transformation rule #"]).strip().lower() == "edh derived":
            # Lookup in EDH sheet
            edh_match = edh_df[
                (edh_df["Source malcode"].str.lower() == str(row["source malcode"]).lower()) &
                (edh_df["Source table"].str.lower() == str(row["source table"]).lower())
            ]
            if not edh_match.empty:
                logic = f"EDH_DERIVED: {edh_match.iloc[0]['Target table']}.{edh_match.iloc[0]['Target column']}"

        # Case 3: Otherwise, fallback to freeform cleaning
        else:
            logic = clean_freeform(str(row["transformation rule auto populate"]))

        cleaned_logic.append(logic)

    stm_df["Cleaned_Transformation"] = cleaned_logic

    # Save output Excel
    stm_df.to_excel(out_file, index=False)

    print(f"\n✅ Cleaned mapping saved to {out_file}\n")

    # Print preview (first 10 rows only)
    preview_cols = [
        "source schema", "source malcode", "source table",
        "target table", "target column",
        "transformation rule #", "Cleaned_Transformation"
    ]
    print("📋 Preview of cleaned transformations (first 10 rows):\n")
    print(stm_df[preview_cols].head(10).to_string(index=False))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Clean STM Transformation Logic from Excel")
    parser.add_argument("excel_file", help="Input Excel file (with 3 sheets)")
    parser.add_argument("--out", default="cleaned_mapping.xlsx", help="Output Excel file")
    args = parser.parse_args()

    build_cleaned_mapping(args.excel_file, args.out)
